{
  "compilerOptions": {
    // Library code must run on Node >= 20 and Bun: Node types only, no Bun globals.
    "lib": ["ES2022"],
    "target": "ES2022",
    "types": ["node"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "isolatedDeclarations": true,
    "declaration": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["src"]
}
