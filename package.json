{
  "name": "@walon-foundation/viewer-sdk-ts",
  "version": "0.1.0",
  "description": "Logger SDK for the Viewer logging platform (Node and Bun, any backend).",
  "keywords": [
    "logging",
    "logger",
    "opentelemetry",
    "otlp",
    "viewer",
    "node",
    "bun"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Walon-Foundation/viewer-sdk-ts.git"
  },
  "homepage": "https://github.com/Walon-Foundation/viewer-sdk-ts#readme",
  "bugs": {
    "url": "https://github.com/Walon-Foundation/viewer-sdk-ts/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/hono.d.ts",
        "default": "./dist/hono.js"
      },
      "require": {
        "types": "./dist/hono.d.cts",
        "default": "./dist/hono.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/fastify.d.ts",
        "default": "./dist/fastify.js"
      },
      "require": {
        "types": "./dist/fastify.d.cts",
        "default": "./dist/fastify.cjs"
      }
    },
    "./elysia": {
      "import": {
        "types": "./dist/elysia.d.ts",
        "default": "./dist/elysia.js"
      },
      "require": {
        "types": "./dist/elysia.d.cts",
        "default": "./dist/elysia.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#sdk": {
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "#internal": {
      "bun": "./src/internal.ts",
      "default": "./dist/internal.js"
    },
    "#hono": {
      "bun": "./src/adapters/hono.ts",
      "default": "./dist/hono.js"
    },
    "#express": {
      "bun": "./src/adapters/express.ts",
      "default": "./dist/express.js"
    },
    "#fastify": {
      "bun": "./src/adapters/fastify.ts",
      "default": "./dist/fastify.js"
    },
    "#elysia": {
      "bun": "./src/adapters/elysia.ts",
      "default": "./dist/elysia.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20",
    "bun": ">=1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "bun test test/",
    "prepublishOnly": "bun run typecheck && bun run lint && bun run build",
    "test:node": "bun --bun tsdown && node --test test/*.test.mjs",
    "size": "bun --bun tsdown && bun scripts/size.mjs"
  },
  "peerDependencies": {
    "elysia": ">=1.2",
    "express": ">=4",
    "fastify": ">=4",
    "hono": ">=4.6"
  },
  "peerDependenciesMeta": {
    "elysia": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@types/express": "5.0.6",
    "@types/node": "20.19.0",
    "elysia": "1.4.31",
    "express": "5.3.0",
    "fastify": "5.12.8",
    "hono": "4.13.18",
    "tsdown": "0.23.7",
    "typescript": "7.0.2"
  }
}
