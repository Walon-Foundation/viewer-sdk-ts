{
  "name": "@walon-foundation/viewer-sdk-ts",
  "version": "0.1.0",
  "description": "Logger SDK for the Viewer logging platform (Node and Bun, any backend).",
  "keywords": [
    "logging",
    "logger",
    "opentelemetry",
    "otlp",
    "viewer",
    "node",
    "bun"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Walon-Foundation/viewer-sdk-ts.git"
  },
  "homepage": "https://github.com/Walon-Foundation/viewer-sdk-ts#readme",
  "bugs": {
    "url": "https://github.com/Walon-Foundation/viewer-sdk-ts/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#sdk": {
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "#internal": {
      "bun": "./src/internal.ts",
      "default": "./dist/internal.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20",
    "bun": ">=1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "bun test test/",
    "prepublishOnly": "bun run typecheck && bun run lint && bun run build",
    "test:node": "tsdown && node --test test/"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@types/node": "20.19.0",
    "tsdown": "0.23.7",
    "typescript": "7.0.2"
  }
}
